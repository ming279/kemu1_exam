 "views": {
  "v_question_stat": "CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_question_stat` AS select `q`.`id` AS `question_id`,`q`.`stem` AS `stem`,`q`.`qtype` AS `qtype`,coalesce(`s`.`attempt_count`,0) AS `attempt_count`,coalesce(`s`.`correct_count`,0) AS `correct_count`,round(((coalesce(`s`.`correct_count`,0) * 100.0) / nullif(`s`.`attempt_count`,0)),2) AS `correct_rate` from (`question` `q` left join (select `t`.`question_id` AS `question_id`,count(0) AS `attempt_count`,sum(`t`.`is_correct`) AS `correct_count` from (select `exam_detail`.`question_id` AS `question_id`,`exam_detail`.`is_correct` AS `is_correct` from `exam_detail` where (`exam_detail`.`is_correct` is not null) union all select `practice`.`question_id` AS `question_id`,`practice`.`is_correct` AS `is_correct` from `practice`) `t` group by `t`.`question_id`) `s` on((`s`.`question_id` = `q`.`id`)))",
  "v_question_stat#rows": 3449,
  "v_user_stat": "CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_user_stat` AS select `u`.`id` AS `user_id`,`u`.`username` AS `username`,coalesce(`p`.`total_answered`,0) AS `total_answered`,coalesce(`p`.`total_correct`,0) AS `total_correct`,round(((coalesce(`p`.`total_correct`,0) * 100.0) / nullif(`p`.`total_answered`,0)),2) AS `accuracy`,coalesce(`w`.`wrong_total`,0) AS `wrong_total`,coalesce(`w`.`wrong_active`,0) AS `wrong_active` from ((`user` `u` left join (select `practice`.`user_id` AS `user_id`,count(0) AS `total_answered`,sum(`practice`.`is_correct`) AS `total_correct` from `practice` group by `practice`.`user_id`) `p` on((`p`.`user_id` = `u`.`id`))) left join (select `wrong_book`.`user_id` AS `user_id`,count(0) AS `wrong_total`,sum((0 = `wrong_book`.`mastered`)) AS `wrong_active` from `wrong_book` group by `wrong_book`.`user_id`) `w` on((`w`.`user_id` = `u`.`id`)))",
  "v_user_stat#rows": 2
 },
